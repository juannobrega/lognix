# ---------------------------------------------------------------------------
# Lognix — configuração mínima. Copie para .env e ajuste.
# Tudo o que não está aqui é configurado pela interface após o primeiro login.
# ---------------------------------------------------------------------------

# OBRIGATÓRIO. Chave usada para criptografar credenciais SSH, chaves de API e
# para assinar sessões. Gere com:
#   openssl rand -base64 48
# Perder esta chave torna as credenciais guardadas irrecuperáveis. Faça backup.
LOGNIX_SECRET_KEY=

# Porta em que a interface fica acessível na máquina do Lognix.
LOGNIX_PORT=8080

# URL pública do Lognix, usada em links (issues do GitHub, fase 1.1+).
LOGNIX_PUBLIC_URL=http://localhost:8080

# Banco de metadados. Os valores abaixo são usados pelo container postgres e
# pelo backend; mude a senha em instalações expostas.
POSTGRES_USER=lognix
POSTGRES_PASSWORD=lognix
POSTGRES_DB=lognix

# Retenção de logs e eventos, em dias.
LOKI_RETENTION_DAYS=15

# Nível de log do próprio backend: DEBUG, INFO, WARNING, ERROR.
LOGNIX_LOG_LEVEL=INFO

# Desempenho. Padrões medidos com 10 hosts e 100 containers; raramente precisam mudar.
# Aumentar a concorrência acima do número de núcleos não acelera nada.
LOGNIX_ANALYSIS_CONCURRENCY=8
LOGNIX_DB_POOL_SIZE=20
LOGNIX_DB_MAX_OVERFLOW=10

# Versão da imagem. Em branco segue a última publicada; fixe para controlar quando atualiza.
# LOGNIX_VERSION=0.0.1
